{
  "name": "bouche-cousue",
  "version": "1.0.0",
  "private": true,
  "description": "Plays a cartoon only while the child's mouth stays closed.",
  "homepage": "https://github.com/raphaelApard/bouche-cousue",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check-only",
    "deploy": "scripts/run-deploy.sh",
    "deploy:dry": "scripts/run-deploy.sh --dry-run",
    "serve": "python3 -m http.server 8000",
    "preview": "python3 -m http.server 8001 --directory dist"
  }
}
